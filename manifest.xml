<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<OfficeApp
  xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
  xsi:type="TaskPaneApp">

  <Id>a7f0d2e3-8b1c-4e5f-9a0b-c3d4e5f6a7b8</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>Paste Minimal Changes</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="Paste Minimal Changes"/>
  <Description DefaultValue="Paste with word-level tracked changes instead of delete-all/insert-all"/>

  <IconUrl DefaultValue="https://tobycraft.github.io/track-minimal-changes/assets/icon-32.png"/>
  <HighResolutionIconUrl DefaultValue="https://tobycraft.github.io/track-minimal-changes/assets/icon-80.png"/>
  <SupportUrl DefaultValue="https://github.com/tobycraft/track-minimal-changes/issues"/>

  <AppDomains>
    <AppDomain>https://tobycraft.github.io</AppDomain>
  </AppDomains>

  <Hosts>
    <Host Name="Document"/>
  </Hosts>

  <DefaultSettings>
    <SourceLocation DefaultValue="https://tobycraft.github.io/track-minimal-changes/taskpane.html"/>
  </DefaultSettings>

  <Permissions>ReadWriteDocument</Permissions>

  <!-- Prototype: ribbon button (no task pane), validated alongside the task
       pane above. See CLAUDE.md design history. Runs commands.html, a
       UI-less function file, so we can test whether navigator.clipboard.readText()
       is reachable when triggered purely by a ribbon click. -->
  <VersionOverrides xmlns="http://schemas.microsoft.com/office/taskpaneappversionoverrides" xsi:type="VersionOverridesV1_0">
    <Requirements>
      <bt:Sets DefaultMinVersion="1.1">
        <bt:Set Name="AddinCommands" MinVersion="1.1"/>
      </bt:Sets>
    </Requirements>
    <Hosts>
      <Host xsi:type="Document">
        <DesktopFormFactor>
          <FunctionFile resid="Commands.Url"/>
          <ExtensionPoint xsi:type="PrimaryCommandSurface">
            <OfficeTab id="TabHome">
              <Group id="MinimalPasteGroup">
                <Label resid="MinimalPasteGroup.Label"/>
                <Icon>
                  <bt:Image size="16" resid="Icon.16x16"/>
                  <bt:Image size="32" resid="Icon.32x32"/>
                  <bt:Image size="80" resid="Icon.80x80"/>
                </Icon>
                <Control xsi:type="Button" id="ApplyMinimalPasteButton">
                  <Label resid="ApplyMinimalPasteButton.Label"/>
                  <Supertip>
                    <Title resid="ApplyMinimalPasteButton.Label"/>
                    <Description resid="ApplyMinimalPasteButton.Tooltip"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16x16"/>
                    <bt:Image size="32" resid="Icon.32x32"/>
                    <bt:Image size="80" resid="Icon.80x80"/>
                  </Icon>
                  <Action xsi:type="ExecuteFunction">
                    <FunctionName>applyMinimalPaste</FunctionName>
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
          <!-- Prototype: right-click context menu entry. The Paste Options
               gallery itself (Keep Source Formatting / Merge / Keep Text
               Only / etc.) is a closed built-in control — no manifest
               extension point can add an item into it. This is the closest
               available alternative: a new entry on the same right-click
               menu, next to where Paste Options appears. Same
               applyMinimalPaste function as the ribbon button. -->
          <ExtensionPoint xsi:type="ContextMenu">
            <OfficeMenu id="ContextMenuText">
              <Control xsi:type="Button" id="ApplyMinimalPasteContextMenuButton">
                <Label resid="ApplyMinimalPasteButton.Label"/>
                <Supertip>
                  <Title resid="ApplyMinimalPasteButton.Label"/>
                  <Description resid="ApplyMinimalPasteButton.Tooltip"/>
                </Supertip>
                <Icon>
                  <bt:Image size="16" resid="Icon.16x16"/>
                  <bt:Image size="32" resid="Icon.32x32"/>
                  <bt:Image size="80" resid="Icon.80x80"/>
                </Icon>
                <Action xsi:type="ExecuteFunction">
                  <FunctionName>applyMinimalPaste</FunctionName>
                </Action>
              </Control>
            </OfficeMenu>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>
    </Hosts>
    <Resources>
      <bt:Images>
        <bt:Image id="Icon.16x16" DefaultValue="https://tobycraft.github.io/track-minimal-changes/assets/icon-16.png"/>
        <bt:Image id="Icon.32x32" DefaultValue="https://tobycraft.github.io/track-minimal-changes/assets/icon-32.png"/>
        <bt:Image id="Icon.80x80" DefaultValue="https://tobycraft.github.io/track-minimal-changes/assets/icon-80.png"/>
      </bt:Images>
      <bt:Urls>
        <bt:Url id="Commands.Url" DefaultValue="https://tobycraft.github.io/track-minimal-changes/commands.html"/>
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="MinimalPasteGroup.Label" DefaultValue="Minimal Paste"/>
        <bt:String id="ApplyMinimalPasteButton.Label" DefaultValue="Apply Minimal Paste"/>
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="ApplyMinimalPasteButton.Tooltip" DefaultValue="Diff the clipboard against the selected text and insert only the changed words as tracked changes. (Prototype: no task pane.)"/>
      </bt:LongStrings>
    </Resources>
  </VersionOverrides>
</OfficeApp>
