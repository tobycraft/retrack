<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  Local-dev variant of manifest.xml — points at the local HTTPS server
  (tests/real-office-e2e/local-https-server.js, https://localhost:3000)
  instead of the deployed GitHub Pages site, so tests/real-office-e2e/
  can iterate on docs/commands.html without a git push + Pages rebuild
  each time. Distinct <Id> from manifest.xml so both can be sideloaded
  side by side without conflict. Not used for real distribution — see
  manifest.xml / setup.ps1 / setup.sh for that.

  <Version> gets bumped automatically by tests/real-office-e2e/word-live.spec.js
  before every test run, since Word's add-in runtime has been observed to
  cache the sideloaded add-in across launches.
-->
<OfficeApp
  xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
  xsi:type="TaskPaneApp">

  <Id>a68fa1de-d662-4f7b-a91d-6e04768a79c2</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>ReTrack</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="ReTrack (local)"/>
  <Description DefaultValue="Local-dev build of ReTrack, served from localhost — not for distribution"/>

  <IconUrl DefaultValue="https://localhost:3000/assets/icon-32.png"/>
  <HighResolutionIconUrl DefaultValue="https://localhost:3000/assets/icon-80.png"/>
  <SupportUrl DefaultValue="https://github.com/tobycraft/retrack/issues"/>

  <AppDomains>
    <AppDomain>https://localhost:3000</AppDomain>
  </AppDomains>

  <Hosts>
    <Host Name="Document"/>
  </Hosts>

  <DefaultSettings>
    <SourceLocation DefaultValue="https://localhost:3000/commands.html"/>
  </DefaultSettings>

  <Permissions>ReadWriteDocument</Permissions>

  <VersionOverrides xmlns="http://schemas.microsoft.com/office/taskpaneappversionoverrides" xsi:type="VersionOverridesV1_0">
    <Hosts>
      <Host xsi:type="Document">
        <DesktopFormFactor>
          <FunctionFile resid="Commands.Url"/>
          <ExtensionPoint xsi:type="PrimaryCommandSurface">
            <OfficeTab id="TabHome">
              <Group id="MinimizeChanges.Group">
                <Label resid="MinimizeChanges.Group.Label"/>
                <Icon>
                  <bt:Image size="16" resid="Icon.16x16"/>
                  <bt:Image size="32" resid="Icon.32x32"/>
                  <bt:Image size="80" resid="Icon.80x80"/>
                </Icon>
                <Control xsi:type="Button" id="MinimizeChanges.Button">
                  <Label resid="MinimizeChanges.Button.Label"/>
                  <Supertip>
                    <Title resid="MinimizeChanges.Button.Label"/>
                    <Description resid="MinimizeChanges.Button.Tooltip"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16x16"/>
                    <bt:Image size="32" resid="Icon.32x32"/>
                    <bt:Image size="80" resid="Icon.80x80"/>
                  </Icon>
                  <Action xsi:type="ExecuteFunction">
                    <FunctionName>minimizeChanges</FunctionName>
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>
    </Hosts>
    <Resources>
      <bt:Images>
        <bt:Image id="Icon.16x16" DefaultValue="https://localhost:3000/assets/icon-16.png"/>
        <bt:Image id="Icon.32x32" DefaultValue="https://localhost:3000/assets/icon-32.png"/>
        <bt:Image id="Icon.80x80" DefaultValue="https://localhost:3000/assets/icon-80.png"/>
      </bt:Images>
      <bt:Urls>
        <bt:Url id="Commands.Url" DefaultValue="https://localhost:3000/commands.html"/>
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="MinimizeChanges.Group.Label" DefaultValue="Track Changes"/>
        <bt:String id="MinimizeChanges.Button.Label" DefaultValue="ReTrack"/>
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="MinimizeChanges.Button.Tooltip" DefaultValue="Rewrite whole-selection tracked changes as word-level tracked changes, keeping only your own edits authored by your Word user name."/>
      </bt:LongStrings>
    </Resources>
  </VersionOverrides>
</OfficeApp>
